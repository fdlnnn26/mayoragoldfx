{
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "node_modules/@google/genai/**",
      "maxDuration": 180
    }
  },
  "rewrites": [
    {
      "source": "/b/:slug",
      "destination": "/api/share?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
